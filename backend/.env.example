PORT=4000
# Required in production: a long random string
JWT_SECRET=change-me-to-a-long-random-string
# Public https address of this server (used to build media URLs)
PUBLIC_URL=http://localhost:4000
# Where the SQLite database file lives (use a persistent disk in production)
DB_FILE=./data/query.db
# Comma-separated emails that get admin (moderation) rights
ADMIN_EMAILS=
# Content is hidden automatically after this many reports, until an admin reviews it
REPORT_HIDE_THRESHOLD=3
# Optional: send password-reset emails through Resend (https://resend.com). Without it, codes print to the console.
RESEND_API_KEY=
MAIL_FROM=Query <no-reply@yourdomain.com>

# Uploaded photos/videos/voice notes (keep on a persistent disk in production)
UPLOAD_DIR=./uploads
# Moderation
SEVERE_REPORT_THRESHOLD=2
STRIKES_TO_BAN=3
# Optional automatic image/video nudity check (https://sightengine.com). Leave empty to rely on text filter + reports.
SIGHTENGINE_USER=
SIGHTENGINE_SECRET=

# ---------- Social ----------
# Public web address used in shared links (usually same as PUBLIC_URL) and store download link
APP_DOWNLOAD_URL=
# Sign in with Apple: your iOS bundle id (and Services ID if you add web sign-in), comma-separated
APPLE_CLIENT_IDS=com.query.app
# Sign in with Google: the OAuth *Web* client ID used by the app (comma-separated if several)
GOOGLE_CLIENT_IDS=
# Facebook Login (optional, later): app id + secret from developers.facebook.com
FB_APP_ID=
FB_APP_SECRET=
# App links so https://your-domain/q/<id> opens the app
APPLE_TEAM_ID=
IOS_BUNDLE_ID=com.query.app
ANDROID_PACKAGE=com.query.app
# SHA-256 fingerprint of your Play app signing key (Play Console → App integrity)
ANDROID_SHA256=
# "Question of the day" on your own Facebook Page / Instagram Business account (after Meta app review)
FB_PAGE_ID=
FB_PAGE_TOKEN=
IG_USER_ID=
# Auto-reply to messages on Messenger / Instagram / WhatsApp Business (after Meta app review)
META_APP_SECRET=
META_VERIFY_TOKEN=
WHATSAPP_TOKEN=

# ---------- LinkedIn ----------
# Sign in with LinkedIn (developer.linkedin.com → your app → Auth). Add this exact redirect URL in LinkedIn:
#   https://YOUR-DOMAIN/auth/linkedin/callback
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Posting to the Query company page (Community Management API — after LinkedIn approval)
LINKEDIN_ORG_ID=
LINKEDIN_ORG_TOKEN=
