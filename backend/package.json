{
  "name": "query-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Query Q&A API \u2014 zero dependencies, Node.js 22.5+",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/server.js",
    "dev": "node --watch --disable-warning=ExperimentalWarning src/server.js",
    "seed": "node --disable-warning=ExperimentalWarning src/seed.js",
    "test": "node --disable-warning=ExperimentalWarning --test tests/*.test.js",
    "backup": "node --disable-warning=ExperimentalWarning scripts/backup.js",
    "make-admin": "node --disable-warning=ExperimentalWarning scripts/make-admin.js"
  }
}