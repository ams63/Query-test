{
  "name": "query",
  "version": "2.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:apk": "eas build -p android --profile preview",
    "build:aab": "eas build -p android --profile production",
    "check:i18n": "node scripts/check-i18n.js",
    "build:ios": "eas build -p ios --profile production",
    "submit:android": "eas submit -p android --profile production",
    "submit:ios": "eas submit -p ios --profile production",
    "setup": "npm install && npx expo install --fix && node scripts/check-i18n.js"
  },
  "dependencies": {
    "@expo-google-fonts/ibm-plex-sans-arabic": "^0.4.1",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-community/cli": "latest",
    "@react-native-google-signin/google-signin": "^15.0.0",
    "expo": "~54.0.0",
    "expo-apple-authentication": "~8.0.7",
    "expo-asset": "~12.0.13",
    "expo-audio": "~1.1.1",
    "expo-clipboard": "~8.0.7",
    "expo-constants": "~18.0.8",
    "expo-device": "~8.0.8",
    "expo-font": "~14.0.8",
    "expo-image": "~3.0.8",
    "expo-image-picker": "~17.0.8",
    "expo-linking": "~8.0.8",
    "expo-location": "~19.0.7",
    "expo-notifications": "~0.32.11",
    "expo-router": "~6.0.8",
    "expo-secure-store": "~15.0.7",
    "expo-sharing": "~14.0.7",
    "expo-splash-screen": "~31.0.10",
    "expo-status-bar": "~3.0.8",
    "expo-store-review": "~9.0.7",
    "expo-video": "~3.0.11",
    "expo-web-browser": "~15.0.8",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-maps": "1.20.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-view-shot": "4.0.3"
